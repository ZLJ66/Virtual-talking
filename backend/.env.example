# ═══════════════════════════════════════════════════════════
#  AI API 配置模板
# ═══════════════════════════════════════════════════════════
#  使用方法：
#    1. 复制本文件为 .env        →  copy .env.example .env
#    2. 填入你自己的 API 密钥
#    3. .env 已被 .gitignore 忽略，不会提交到版本库
#
#  ⚠️ 切勿把真实密钥写进本文件（.env.example 是要提交的）
# ═══════════════════════════════════════════════════════════

# AI 服务地址（OpenAI 兼容接口，需以 /v1 结尾）
AI_BASE_URL=https://your-api-endpoint.example/v1

# API 密钥
AI_API_KEY=sk-your-api-key-here

# 使用的模型名称
AI_MODEL=your-model-name
