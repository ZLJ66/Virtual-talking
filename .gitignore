# ═══════════════════════════════════════════════════════════
#  AI 沉浸式英语表达模拟器 · 版本控制忽略规则
# ═══════════════════════════════════════════════════════════
#  原则：只提交「源代码 + 内容数据 + 文档」，
#        不提交「依赖、构建产物、密钥、日志、临时文件」。
# ═══════════════════════════════════════════════════════════

# ── 密钥与本地配置（最高优先级，绝不可提交）────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets.json
credentials.json

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / 前端 ───────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ── 包管理器缓存 ──────────────────────────────────────
.pnpm-store/
.npm/
.yarn/
pnpm-debug.log*

# ── 日志与运行产物 ────────────────────────────────────
*.log
logs/
*_log.txt
bat_run_log.txt

# ── 工具与代理产生的临时目录 ──────────────────────────
.playwright-cli/
.acl-recovery/
.cache/
tmp/
temp/

# ── 编辑器与系统 ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ── 本地数据库（运行时生成，不入库）───────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal

# ── 临时截图与调试文件 ────────────────────────────────
*-debug.png
*-debug.jpg
