# ═══════════════════════════════════════════════════════════
#  Git 属性配置：统一换行符与二进制识别
# ═══════════════════════════════════════════════════════════
#  背景：本项目在 Windows 上开发，但 git 的 core.autocrlf 未设置。
#        若不声明，换行符会随编辑器变化，导致 diff 出现整文件差异。
#
#  策略：源码统一存为 LF（仓库内一致），检出时按平台还原。
#        .bat 例外——Windows 批处理必须用 CRLF，否则可能执行异常。
# ═══════════════════════════════════════════════════════════

# 默认：自动识别文本，仓库内存 LF
* text=auto eol=lf

# ── Windows 批处理必须保留 CRLF ───────────────────────
*.bat text eol=crlf
*.cmd text eol=crlf

# ── 明确按文本处理（LF）───────────────────────────────
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf

# ── 二进制文件：不做换行符转换 ────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary

# ── 锁文件：视为生成物，diff 无意义，且在合并冲突时
#    应由包管理器重新生成而非手工解决 ──────────────────
pnpm-lock.yaml  -diff linguist-generated
package-lock.json -diff linguist-generated
yarn.lock       -diff linguist-generated

# ── 语言统计：文档与第三方代码不计入仓库语言占比 ──────
PRDs/*.md linguist-documentation
